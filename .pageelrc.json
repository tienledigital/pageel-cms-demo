{
  "version": 2,
  "plugins": {
    "editor": "@pageel/plugin-mdx"
  },
  "settings": {
    "projectType": "astro",
    "postFileTypes": ".md,.mdx",
    "imageFileTypes": "image/*",
    "publishDateSource": "file",
    "imageCompressionEnabled": true,
    "maxImageSize": 500,
    "imageResizeMaxWidth": 1024,
    "newPostCommit": "feat(content): add post \"{filename}\"",
    "updatePostCommit": "fix(content): update post \"{filename}\"",
    "newImageCommit": "feat(assets): add image \"{filename}\"",
    "updateImageCommit": "refactor(assets): update image for \"{filename}\""
  },
  "commitMessages": {
    "newPost": "feat(content): add post \"{filename}\"",
    "updatePost": "fix(content): update post \"{filename}\"",
    "newImage": "feat(assets): add image \"{filename}\"",
    "updateImage": "refactor(assets): update image for \"{filename}\""
  },
  "collections": [
    {
      "id": "blog",
      "name": "Blog",
      "postsPath": "src/content/blog",
      "imagesPath": "public/images",
      "template": {
        "fields": [
          {
            "name": "title",
            "type": "string"
          },
          {
            "name": "description",
            "type": "string"
          },
          {
            "name": "pubDate",
            "type": "date"
          },
          {
            "name": "author",
            "type": "string"
          },
          {
            "name": "image",
            "type": "string"
          },
          {
            "name": "tags",
            "type": "array"
          },
          {
            "name": "draft",
            "type": "string"
          }
        ]
      },
      "tableColumns": [
        "description",
        "pubDate",
        "author",
        "tags",
        "draft"
      ],
      "columnWidths": {
        "__name__": 40,
        "description": 30
      }
    },
    {
      "id": "docs",
      "name": "Docs",
      "postsPath": "src/content/docs",
      "imagesPath": "public/images",
      "template": {
        "fields": [
          {
            "name": "title",
            "type": "string"
          },
          {
            "name": "order",
            "type": "string"
          },
          {
            "name": "category",
            "type": "string"
          }
        ]
      },
      "tableColumns": [
        "order",
        "category"
      ],
      "columnWidths": {
        "__name__": 35
      }
    }
  ],
  "activeCollectionId": "blog"
}